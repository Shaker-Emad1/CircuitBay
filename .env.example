# CircuitBay Environment Variables Template
# Copy this file to .env and replace placeholders with your actual production/development settings.

# SQL Server Configuration
MSSQL_SA_PASSWORD=YourStrongPasswordHere!2026
ConnectionStrings__CircuitBay=Server=sql,1433;Database=CircuitBay;User Id=sa;Password=YourStrongPasswordHere!2026;TrustServerCertificate=True;MultipleActiveResultSets=True

# Redis Configuration
ConnectionStrings__Redis=redis:6379

# JWT Token Security (Must be at least 32 characters long)
Jwt__Issuer=CircuitBay
Jwt__Audience=CircuitBay.Api
Jwt__SigningKey=YourProductionJwtSecretKeyMustBe32CharactersOrLonger!
Jwt__Minutes=90

# Infrastructure & Startup Configuration
Infrastructure__Startup__DatabaseMaxAttempts=45
Infrastructure__Startup__DatabaseDelaySeconds=3
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
