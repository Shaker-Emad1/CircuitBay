{
  "ConnectionStrings": {
    "CircuitBay": "Server=localhost,1433;Database=CircuitBay;User Id=sa;Password=${CIRCUITBAY_SQL_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CircuitBay",
    "Audience": "CircuitBay.Api",
    "SigningKey": "dev-only-change-with-CIRCUITBAY_JWT_KEY-32chars",
    "Minutes": 90
  },
  "Infrastructure": {
    "Startup": {
      "DatabaseMaxAttempts": 20,
      "DatabaseDelaySeconds": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
