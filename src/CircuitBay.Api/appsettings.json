{
  "ConnectionStrings": {
    "CircuitBay": "Server=localhost,1433;Database=CircuitBay;User Id=sa;Password=YOUR_SQL_PASSWORD_HERE;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CircuitBay",
    "Audience": "CircuitBay.Api",
    "SigningKey": "YOUR_SECURE_JWT_SIGNING_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "Minutes": 90
  },
  "Infrastructure": {
    "Startup": {
      "DatabaseMaxAttempts": 20,
      "DatabaseDelaySeconds": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
